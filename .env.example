# Mainnet only. Never place a private key in this file.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://bot:bot@localhost:5432/berabot
REDIS_URL=redis://localhost:6379

PRIMARY_RPC_HTTP_URL=https://rpc.berachain.com
SECONDARY_RPC_HTTP_URL=https://berachain-rpc.publicnode.com
# Optional independent WebSocket used only for eth_subscribe/newHeads triggers.
HEADS_RPC_WS_URL=
BERA_API_URL=https://api.berachain.com/

# Supplied through the server secret manager at the relevant milestone.
MINIMAX_API_KEY=
MINIMAX_API_KEY_FILE=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TOOL_ROUNDS=2
# Versioned Scarlet system prompt loaded at runtime (path relative to the working dir).
SCARLET_PROMPT_PATH=src/prompts/scarlet.md
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=
# VPS deployment: leave WALLET_PRIVATE_KEY blank and use docker-compose.vps.yml.
WALLET_PRIVATE_KEY_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Financial guardrails. EXECUTION_ENABLED must remain false until the wallet is funded.
EXECUTION_ENABLED=false
DAILY_LOSS_LIMIT_USD=5
# BERA-first launch: keep the account observable and safe even before it reaches $20 NAV.
MIN_NAV_USD=0.10
MIN_BERA_RESERVE=1
MAX_SLIPPAGE_BPS=100
MAX_QUOTE_AGE_MS=20000
BASE_ASSET=BERA
USDC_E_ADDRESS=0x549943e04f40284185054145c6e4e9568c1d3241
HONEY_ADDRESS=0xFCBD14DC51f0A4d49d5E53C2E0950e0bC26d0Dce
WBERA_ADDRESS=0x6969696969696969696969696969696969696969
BEND_MORPHO_ADDRESS=0x24147243f9c08d835C218Cda1e135f8dFD0517D0
# Official current Bend market IDs. A comma-separated list is scanned from real mainnet events.
BEND_MARKET_IDS=0x950962c1cf2591f15806e938bfde9b5f9fbbfcc5fb640030952c08b536f1f167,0x1ba7904c73d337c39cb88b00180dffb215fc334a6ff47bbe829cd9ee2af00c97,0x63c2a7c20192095c15d1d668ccce6912999b01ea60eeafcac66eca32015674dd,0x1f05d324f604bd1654ec040311d2ac4f5820ecfd1801a3d19d2c6f09d4f7a614,0x147b032db82d765b9d971eac37c8176260dde0fe91f6a542f20cdd9ede1054df,0x594de722a090f8d0df41087c23e2187fb69d9cd6b7b425c6dd56ddc1cff545f0
BEND_LOG_LOOKBACK_BLOCKS=50000
BEND_BACKFILL_BLOCKS_PER_SCAN=500
BEND_MAX_POSITION_READS_PER_SCAN=25
BEND_ARCHIVE_RPC_URL=https://berachain.drpc.org
BEND_SCAN_INTERVAL_MS=20000
# 20-minute production bootstrap for a self-custodial WBERA wrap only. Every
# BEX/Bend interaction then needs the six-hour evidence window plus dual-RPC
# preflight immediately before broadcast.
BOOTSTRAP_GATE_MINUTES=20
OBSERVATION_GATE_HOURS=6
MIN_OBSERVATION_HEALTH_RATIO=0.95
MAX_OBSERVATION_GAP_SECONDS=15
MICRO_TEST_MAX_LOSS_USD=0.05
# Promoted allocations become eligible only after the real onboarding cycle
# (deposit, seven-day observation, withdrawal) has succeeded.
ACTIVE_STRATEGY_MAX_ALLOCATION_PCT=0.50
ACTIVE_STRATEGY_MIN_CAPITAL_USD=1
ACTIVE_YIELD_HORIZON_DAYS=30
ACTIVE_MIN_NET_PROFIT_USD=0.03
